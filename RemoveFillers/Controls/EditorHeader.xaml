<UserControl
    x:Class="RemoveFillers.Controls.EditorHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#181920" BorderBrush="#30313C" BorderThickness="0,0,0,1">
        <Grid Padding="20,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="#8065ED">
                    <FontIcon Glyph="&#xE714;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Untitled project" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Your creative workspace" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Border Margin="12,0,0,0" Padding="8,4" CornerRadius="5" Background="#2B293B">
                    <TextBlock Text="SAMPLE MODE" FontSize="10" FontWeight="SemiBold" Foreground="#C6B9FF" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="In-memory demo - no files are saved" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                <Button Content="Export" IsEnabled="False" ToolTipService.ToolTip="Real video export is not available in sample mode." />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
