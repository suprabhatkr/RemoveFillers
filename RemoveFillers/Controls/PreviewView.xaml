<UserControl x:Class="RemoveFillers.Controls.PreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#121318" Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="PREVIEW" FontSize="10" CharacterSpacing="100" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" Background="#262730" CornerRadius="5" Padding="8,4"><TextBlock Text="16:9" FontSize="11" Foreground="#C8C8D1" /></Border>
        </Grid>
        <Viewbox Grid.Row="1" Stretch="Uniform" MaxWidth="720" MaxHeight="405">
            <Border Width="640" Height="360" CornerRadius="8" Background="#232333" BorderBrush="#353547" BorderThickness="1">
                <Grid>
                    <Ellipse Width="190" Height="190" Fill="#2C2944" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="58" Height="58" CornerRadius="18" Background="#6550BD" HorizontalAlignment="Center"><FontIcon Glyph="&#xE714;" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <MediaPlayerElement x:Name="PreviewPlayer" MaxWidth="400" AutoPlay="False" AreTransportControlsEnabled="True" />
                        <TextBlock x:Name="PreviewTitle" Text="Your story starts here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="PreviewSubtitle" Text="Add sample media to begin" FontSize="13" Foreground="#B2AEC4" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Viewbox>
        <Grid Grid.Row="2">
            <TextBlock x:Name="TimeText" Text="00:00 / 00:00" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="Back five seconds" AutomationProperties.Name="Back five seconds"><FontIcon Glyph="&#xE892;" FontSize="14" /></Button>
                <Button x:Name="PlayButton" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="Play or pause simulation" AutomationProperties.Name="Play or pause simulation"><FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" /></Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="Forward five seconds" AutomationProperties.Name="Forward five seconds"><FontIcon Glyph="&#xE893;" FontSize="14" /></Button>
            </StackPanel>
            <TextBlock Text="Fit" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        </Grid>
    </Grid>
</UserControl>
