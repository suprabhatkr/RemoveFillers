<UserControl x:Class="RemoveFillers.Controls.EditorSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#171820">
        <StackPanel Padding="6,14" Spacing="4">
            <Border Background="#302B48" CornerRadius="8">
                <StackPanel Width="64" Height="60" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="#C2B1FF" HorizontalAlignment="Center" />
                    <TextBlock Text="Media" FontSize="11" Foreground="#D6CCFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource RailButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="Audio tools are coming soon.">
                <StackPanel Spacing="5"><FontIcon Glyph="&#xE8D6;" FontSize="18" /><TextBlock Text="Audio" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
            </Button>
            <Button Style="{StaticResource RailButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="Text tools are coming soon.">
                <StackPanel Spacing="5"><FontIcon Glyph="&#xE8D2;" FontSize="18" /><TextBlock Text="Text" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
            </Button>
            <Button Style="{StaticResource RailButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="Effects are coming soon.">
                <StackPanel Spacing="5"><FontIcon Glyph="&#xE790;" FontSize="18" /><TextBlock Text="Effects" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
            </Button>
            <Button Style="{StaticResource RailButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="Transitions are coming soon.">
                <StackPanel Spacing="5"><FontIcon Glyph="&#xE8AB;" FontSize="18" /><TextBlock Text="Transitions" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
